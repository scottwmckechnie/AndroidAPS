+package app.aaps.pump.omnipod.dash.autodeactivate
+
+import app.aaps.pump.omnipod.common.bledriver.pod.definition.AlarmType
+import app.aaps.pump.omnipod.common.bledriver.pod.definition.PodStatus
+import com.google.common.truth.Truth.assertThat
+import org.junit.jupiter.api.Test
+
+/**
+ * The trigger for the personal auto-deactivate mod. It must fire only on the pod's own expiry report:
+ * a wrong "true" here deactivates a pod and stops insulin.
+ */
+class ExpiredPodAutoDeactivateTest {
+
+    private val expired = (80 * 60).toShort()
+
+    @Test
+    fun `fires on alarm state, fault 0x1C and at least 79 h by the pod's own count`() {
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, AlarmType.ALARM_PUMP_EXPIRED, expired)).isTrue()
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, AlarmType.ALARM_PUMP_EXPIRED, (79 * 60).toShort())).isTrue()
+    }
+
+    @Test
+    fun `fault code 0x1C is the pump-expired alarm`() {
+        assertThat(AlarmType.ALARM_PUMP_EXPIRED.code).isEqualTo(0x1C)
+        assertThat(PodStatus.ALARM.value).isEqualTo(0x0D.toByte())
+    }
+
+    @Test
+    fun `does not fire before 79 h even with fault 0x1C`() {
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, AlarmType.ALARM_PUMP_EXPIRED, (79 * 60 - 1).toShort())).isFalse()
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, AlarmType.ALARM_PUMP_EXPIRED, 100)).isFalse()
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, AlarmType.ALARM_PUMP_EXPIRED, (-1).toShort())).isFalse()
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, AlarmType.ALARM_PUMP_EXPIRED, null)).isFalse()
+    }
+
+    @Test
+    fun `does not fire on any other fault`() {
+        AlarmType.entries.filter { it != AlarmType.ALARM_PUMP_EXPIRED }.forEach {
+            assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, it, expired)).isFalse()
+        }
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(PodStatus.ALARM, null, expired)).isFalse()
+    }
+
+    @Test
+    fun `does not fire unless the pod is in its alarm state`() {
+        PodStatus.entries.filter { it != PodStatus.ALARM }.forEach {
+            assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(it, AlarmType.ALARM_PUMP_EXPIRED, expired)).isFalse()
+        }
+        assertThat(ExpiredPodAutoDeactivate.isPodReportedExpired(null, AlarmType.ALARM_PUMP_EXPIRED, expired)).isFalse()
+    }
+
+    @Test
+    fun `blocks while a bolus is queued or delivering or a delivery command is unconfirmed`() {
+        assertThat(ExpiredPodAutoDeactivate.blockReason(bolusQueued = false, bolusInProgress = false, unconfirmedDeliveryCommand = false)).isNull()
+        assertThat(ExpiredPodAutoDeactivate.blockReason(bolusQueued = true, bolusInProgress = false, unconfirmedDeliveryCommand = false))
+            .isEqualTo(ExpiredPodAutoDeactivate.Block.BOLUS_QUEUED)
+        assertThat(ExpiredPodAutoDeactivate.blockReason(bolusQueued = false, bolusInProgress = true, unconfirmedDeliveryCommand = false))
+            .isEqualTo(ExpiredPodAutoDeactivate.Block.BOLUS_IN_PROGRESS)
+        assertThat(ExpiredPodAutoDeactivate.blockReason(bolusQueued = false, bolusInProgress = false, unconfirmedDeliveryCommand = true))
+            .isEqualTo(ExpiredPodAutoDeactivate.Block.UNCONFIRMED_DELIVERY_COMMAND)
+    }
+
+    @Test
+    fun `attempts are counted per pod and give up at the cap`() {
+        val attempts = ExpiredPodAttempts()
+        repeat(ExpiredPodAutoDeactivate.MAX_ATTEMPTS - 1) { attempts.recordFailure(42L) }
+        assertThat(attempts.hasGivenUp(42L)).isFalse()
+        assertThat(attempts.recordFailure(42L)).isEqualTo(ExpiredPodAutoDeactivate.MAX_ATTEMPTS)
+        assertThat(attempts.hasGivenUp(42L)).isTrue()
+        // a new pod starts fresh
+        assertThat(attempts.hasGivenUp(43L)).isFalse()
+        assertThat(attempts.recordFailure(43L)).isEqualTo(1)
+        attempts.clear()
+        assertThat(attempts.hasGivenUp(43L)).isFalse()
+    }
+}
