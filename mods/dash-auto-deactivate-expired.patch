+package app.aaps.pump.omnipod.dash.autodeactivate
+
+import app.aaps.core.interfaces.queue.CustomCommand
+import app.aaps.pump.omnipod.common.bledriver.pod.definition.AlarmType
+import app.aaps.pump.omnipod.common.bledriver.pod.definition.PodStatus
+
+/**
+ * Personal mod: auto-deactivate a Dash pod that has itself reported its hard end of life.
+ *
+ * The decision uses only what the pod reported (status, fault code, its own minutes-since-activation
+ * counter). It never looks at the phone clock or at AAPS's own expiry estimate, so a clock or time-zone
+ * error can not get a working pod deactivated.
+ */
+object ExpiredPodAutoDeactivate {
+
+    /** The pod's own counter must show at least this; it faults 0x1C at 80 h. Guards a misread fault byte. */
+    const val MIN_POD_MINUTES_SINCE_ACTIVATION = 79 * 60
+
+    /** Attempts per pod (queued sends that were blocked or failed) before giving up and leaving it to Scott. */
+    const val MAX_ATTEMPTS = 6
+
+    const val RETRY_DELAY_MS = 2L * 60 * 1000
+
+    /** True only when the pod itself says: alarm state, fault 0x1C (pod expired), and at least 79 h old by its own count. */
+    fun isPodReportedExpired(podStatus: PodStatus?, alarmType: AlarmType?, minutesSinceActivation: Short?): Boolean =
+        podStatus == PodStatus.ALARM &&
+            alarmType == AlarmType.ALARM_PUMP_EXPIRED &&
+            minutesSinceActivation != null &&
+            minutesSinceActivation.toInt() >= MIN_POD_MINUTES_SINCE_ACTIVATION
+
+    enum class Block { BOLUS_QUEUED, BOLUS_IN_PROGRESS, UNCONFIRMED_DELIVERY_COMMAND }
+
+    /**
+     * Why the deactivate must not be sent right now, or null when it may be sent.
+     * [unconfirmedDeliveryCommand] is true for any unconfirmed pod command other than an earlier deactivate.
+     */
+    fun blockReason(bolusQueued: Boolean, bolusInProgress: Boolean, unconfirmedDeliveryCommand: Boolean): Block? = when {
+        bolusInProgress            -> Block.BOLUS_IN_PROGRESS
+        bolusQueued                -> Block.BOLUS_QUEUED
+        unconfirmedDeliveryCommand -> Block.UNCONFIRMED_DELIVERY_COMMAND
+        else                       -> null
+    }
+}
+
+/** Counts attempts per pod, so a new pod starts fresh and a pod that keeps failing is given up on. */
+class ExpiredPodAttempts {
+
+    private var podId: Long? = null
+    private var attempts = 0
+
+    @Synchronized
+    fun recordFailure(forPod: Long?): Int {
+        if (forPod != podId) {
+            podId = forPod
+            attempts = 0
+        }
+        attempts++
+        return attempts
+    }
+
+    @Synchronized
+    fun hasGivenUp(forPod: Long?): Boolean = forPod == podId && attempts >= ExpiredPodAutoDeactivate.MAX_ATTEMPTS
+
+    @Synchronized
+    fun clear() {
+        podId = null
+        attempts = 0
+    }
+}
+
+class CommandAutoDeactivateExpiredPod : CustomCommand {
+
+    override val statusDescription = "AUTO DEACTIVATE EXPIRED POD"
+}
